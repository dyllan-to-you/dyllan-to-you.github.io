---
import { getCollection } from "astro:content";
import Tome from "../components/tome/Tome.svelte";
import StickyNote from "../components/post/StickyNote.svelte";
import { extractSections, type TomePage } from "../lib/page";
import { isPublished } from "../lib/content";
import { escapeHtml } from "../lib/html";
import { renderBody as renderWritingBody, getReadingTime, type Writing } from "../lib/writing";
import "../styles/guide.css";

const SITE_DESCRIPTION =
  "Personal site of Dyllan Justice Tô-Yu — solo founder of Playfaire PBC.";
// Default share image. A bespoke per-writing/OG card is a follow-up (D3 NOT);
// /hatman.jpg is an existing public/ asset so the card is never blank.
const DEFAULT_OG_IMAGE = "/hatman.jpg";

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of THIS route — drives <link rel=canonical> + og:url so a
   *  shared link unfurls (and crawlers canonicalize) as itself, not the cover.
   *  `[...slug].astro` derives it from Astro.site + the route's own pathname.
   *  Falls back to the site root if a consumer omits it. */
  canonicalURL?: string;
}

const {
  title = "Justice — Builder · Musician · Architect",
  description = SITE_DESCRIPTION,
  canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href,
} = Astro.props;

// Absolute OG image URL (social scrapers reject relative paths).
const ogImageURL = Astro.site
  ? new URL(DEFAULT_OG_IMAGE, Astro.site).href
  : DEFAULT_OG_IMAGE;

// Book pages — sorted by declared order. Drafts visible in dev only.
// `isPublished` is the SHARED predicate [...slug].astro's getStaticPaths uses,
// so the rendered page set and the generated route set cannot drift.
const rawPages = await getCollection("pages", ({ data }) => isPublished(data));
const sortedPages = rawPages.sort((a, b) => a.data.order - b.data.order);

// Writings — newest first for card listing; same order for in-book pages.
const publishedWritings = (
  await getCollection("writings", ({ data }) => isPublished(data))
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

/** Format a writing's date for the in-book header. */
function fmtDate(d: Date): string {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}

/** Compact date for the TOC meta column — "Apr 26". */
function shortDate(d: Date): string {
  return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

/** Render a writing as the HTML body of an in-book page. Includes title,
 *  description, date/tags, and the voice-attributed body. Styles are shared
 *  globally below via .writing-header / .writing-body overrides. */
function renderWritingAsBookPage(w: Writing): string {
  const tags = w.tags.map((t) => `<span class="tag">#${escapeHtml(t)}</span>`).join(" ");
  const subtitle = w.description ? `<p class="writing-subtitle">${escapeHtml(w.description)}</p>` : "";
  const tagsMarkup = tags ? `<span class="tags">${tags}</span>` : "";
  const readingMinutes = getReadingTime(w);
  return `
<header class="writing-header">
  <h1 class="writing-title">${escapeHtml(w.title)}</h1>
  ${subtitle}
  <div class="writing-meta">
    <time datetime="${w.date.toISOString()}">${fmtDate(w.date)}</time>
    <span class="reading-time" aria-label="${readingMinutes} minute read">${readingMinutes} min read</span>
    ${tagsMarkup}
  </div>
</header>
<div class="writing-body">
${renderWritingBody(w)}
</div>
`.trim();
}

/** Fault-isolation boundary for one writing's render (D-BUILDFAIL).
 *
 *  `renderWritingBody` throws on a bad `{s:id}` ref, unknown voice/prompt, or
 *  span cycle. Unguarded, one content typo aborts the WHOLE static build.
 *
 *  Policy: dev-soft / CI-hard.
 *    - PROD: re-throw, enriched with the writing's entry id, so `astro build`
 *      still hard-gates publish (fail visibly — the build is the gate).
 *    - DEV:  degrade to a LOUD error card naming the writing + the literal
 *      error, and warn at build time, so authoring of OTHER writings keeps
 *      working (defense in depth — the card is the SIMPLER fallback, not a
 *      second system). The card is built from escaped strings only, so it
 *      cannot itself throw.
 */
function renderWritingAsBookPageSafe(w: Writing, entryId: string): string {
  try {
    return renderWritingAsBookPage(w);
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    if (import.meta.env.PROD) {
      throw new Error(`Failed to render writing "${entryId}": ${message}`);
    }
    // biome-ignore lint/suspicious/noConsole: build-time author diagnostic — surfaces the broken writing in the dev terminal; the rendered card surfaces it in the book.
    console.warn(`[BookLayout] writing "${entryId}" failed to render: ${message}`);
    return `
<div class="writing-render-error" role="alert">
  <strong>⚠ This writing failed to render.</strong>
  <p class="writing-render-error__id">writing: <code>${escapeHtml(entryId)}</code></p>
  <pre class="writing-render-error__message">${escapeHtml(message)}</pre>
</div>
`.trim();
  }
}

// Compose the tome page array. Writings are injected right after the
// "writings" index page so they live as interior chapters of the book.
const pages: TomePage[] = [];

for (const entry of sortedPages) {
  const data = entry.data;
  let cards = data.cards;
  if (data.cardsSource === "writings") {
    // Cards on the writings index page link to the in-book pages that
    // follow. Hrefs stay as permalinks for shareability; the tome engine
    // flips in-book when the slug matches a known page.
    cards = publishedWritings.map((w) => ({
      name: w.data.title,
      description: w.data.description ?? "",
      href: `/writings/${w.id}`,
    }));
  }

  pages.push({
    ...data,
    body: data.body,
    sections: data.body ? extractSections(data.body) : [],
    cards,
  });

  // Inject writings as book pages after the Writings index.
  if (data.slug === "writings") {
    publishedWritings.forEach((w, i) => {
      pages.push({
        slug: `writings/${w.id}`,
        // Monotonic computed order: parent index order + a fractional
        // increment that lands every injected writing strictly after the
        // writings-index page and before the next top-level page (R15).
        // Survives a hypothetical post-injection sort-by-order; no longer
        // relies on push() insertion order as the silent sort key.
        order: data.order + (i + 1) / (publishedWritings.length + 1),
        // We only iterate `publishedWritings` (drafts already filtered above),
        // so an injected writing page is published by construction.
        draft: false,
        label: w.data.title,
        toc: w.data.title,
        pageLayout: "content",
        header: `> writings / ${w.id}`,
        body: renderWritingAsBookPageSafe(w.data, w.id),
        meta: shortDate(w.data.date),
      });
    });
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    {/* Open Graph — per-route, so a shared link unfurls as itself, not the cover. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="dyllan.to" />

    {/* Twitter card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    {/* Tome stays client:load (D5 finding). The SSR'd first state is the CLOSED
        COVER (flipped=0) on EVERY route — the cascade-to-target that reveals a
        deep-nav route's actual content runs in onMount, AFTER hydration. Under
        client:idle, requestIdleCallback can defer hydration well past first
        paint on a busy main thread (944-line island + cover-sigil animation),
        so a visitor deep-linked to /resume would stare at a closed book until
        idle fires. That's a real dead-book window → keep client:load. (Closing
        it properly needs an SSR'd-readable first spread — deferred to Stage 2
        / the content-first inversion, out of scope this phase.) */}
    <Tome client:load pages={pages} />
    {/* StickyNote → client:idle: a passive hover/focus overlay with zero
        first-paint responsibility. Its listeners only matter once the user
        interacts, so deferring hydration to idle is a free first-load win with
        no dead-window (D5 Stage 1). */}
    <StickyNote client:idle />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    /* Body itself scrolls so browser zoom + reflow (WCAG 1.4.10) is not
       trapped by a viewport-locked book. The tome root clips its own 3D
       overflow so leaves can't escape laterally during page flips. */
  }

  /* ─── In-book writing styling ─────────────────────────────────────── */
  .writing-header {
    margin: 4px 0 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(184, 115, 51, 0.18);
  }
  .writing-title {
    font-family: var(--tome-font-display);
    color: var(--tome-ink);
    font-size: var(--tome-text-title);
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 6px;
    letter-spacing: 0.01em;
  }
  .writing-subtitle {
    font-family: var(--tome-font-body);
    font-style: italic;
    color: var(--tome-ink-light);
    font-size: var(--tome-text-chrome);
    line-height: 1.4;
    margin: 0 0 10px;
  }
  .writing-meta {
    font-family: var(--tome-font-mono);
    color: var(--tome-term-dim);
    font-size: var(--tome-text-caption);
    letter-spacing: 0.06em;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .writing-meta .tags { display: inline-flex; gap: 6px; }
  .writing-meta .tag { color: var(--tome-term-green); opacity: 0.75; }

  .writing-body {
    font-family: var(--tome-font-body);
    color: var(--tome-ink);
    font-size: var(--tome-text-body);
    line-height: 1.7;
  }
  .writing-body p { margin: 0 0 14px; }
  .writing-body p:last-child { margin: 0; }
  .writing-body hr {
    width: 60px; height: 1px; border: none; margin: 18px auto;
    background: linear-gradient(90deg, transparent, var(--tome-copper), transparent);
  }
  .writing-body a {
    color: var(--tome-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .writing-body a:hover { color: var(--tome-voice-justice); }

  .voice-legend {
    font-family: var(--tome-font-mono);
    font-size: var(--tome-text-caption);
    line-height: 1.5;
    color: var(--tome-term-dim);
    padding: 10px 12px;
    margin: 0 0 14px;
    border: 1px solid rgba(184, 115, 51, 0.18);
    border-radius: 2px;
    background: rgba(224, 208, 176, 0.25);
  }

  /* ─── Dev-only writing render-error card (D-BUILDFAIL) ────────────────
     Loud by design: a broken writing degrades to THIS in dev, never a
     silent drop. Never reaches prod — PROD re-throws and aborts the build. */
  .writing-render-error {
    font-family: var(--tome-font-mono);
    font-size: var(--tome-text-caption);
    line-height: 1.6;
    color: #7a1f1f;
    padding: 16px 18px;
    margin: 12px 0;
    border: 2px solid #c0392b;
    border-radius: 3px;
    background: rgba(192, 57, 43, 0.08);
  }
  .writing-render-error strong {
    display: block;
    font-size: var(--tome-text-chrome);
    margin-bottom: 8px;
  }
  .writing-render-error__id { margin: 0 0 8px; }
  .writing-render-error__id code {
    background: rgba(192, 57, 43, 0.12);
    padding: 1px 5px;
    border-radius: 2px;
  }
  .writing-render-error__message {
    white-space: pre-wrap;
    margin: 0;
    padding: 8px 10px;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 2px;
  }

</style>
